# Copy to .env and fill in. .env is gitignored — keep the real URI out of git.

# --- MongoDB / AWS DocumentDB ---------------------------------------------
# Database is taken from the URI path unless IPR_MONGODB_DB is set.
# DocumentDB requires retryWrites=false.
MONGODB_URI=mongodb://user:pass@host:27017/dbname?directConnection=true&tls=true&retryWrites=false&authSource=admin
IPR_MONGODB_DB=

# Collection names.
IPR_COLLECTION_APPLICATIONS=applications
IPR_COLLECTION_SNAPSHOTS=status_snapshots
IPR_COLLECTION_CAPTCHA=captcha_challenges
IPR_COLLECTION_RUNS=scrape_runs

# --- Politeness / throughput ----------------------------------------------
# Minimum seconds between requests to the portal. Do not lower casually: this is
# a shared government host and hammering it gets your IP blocked.
IPR_MIN_REQUEST_INTERVAL=1.5
IPR_HTTP_TIMEOUT=45
# Fresh CAPTCHA fetched per attempt; each rejected answer consumes its image.
IPR_MAX_CAPTCHA_ATTEMPTS=4
IPR_MAX_TARGET_ATTEMPTS=5

# --- CAPTCHA operator UI --------------------------------------------------
IPR_OPERATOR_HOST=127.0.0.1
IPR_OPERATOR_PORT=8765
# How long a worker waits for a human before requeueing the record.
IPR_CAPTCHA_WAIT_TIMEOUT=180

# --- Debug ---------------------------------------------------------------
IPR_SAVE_RAW_HTML=true
IPR_RAW_HTML_DIR=data/raw
